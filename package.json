{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "tsx src/lib/__tests__/account-credential-security.test.ts && tsx src/lib/__tests__/medical-document-validator.test.ts && tsx src/lib/__tests__/ocr-groundtruth-diagnostic.test.ts && tsx src/lib/__tests__/abnormal-panel-ocr-extractor.test.ts && tsx src/lib/__tests__/generalized-document-extraction.test.ts && tsx src/lib/__tests__/decrypt-view-pipeline.test.ts && tsx src/lib/__tests__/dynamic-lab-insights.test.ts",
    "benchmark": "tsx ocr-benchmark/benchmark-runner.ts",
    "knowledge:crawl": "tsx knowledge-pipeline/crawler/crawler.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dexie": "^4.4.4",
    "dexie-react-hooks": "^4.4.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "tesseract.js": "^7.0.0"
  },

  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
