# Vital Diaries — Django Backend Configuration

# Django Core
DJANGO_SECRET_KEY="django-insecure-vital-diaries-dev-key-replace-in-production"
DJANGO_DEBUG="True"
DJANGO_ALLOWED_HOSTS="localhost,127.0.0.1,0.0.0.0"

# PostgreSQL Database Settings
DB_NAME="vital_diaries_db"
DB_USER="vital_user"
DB_PASSWORD="vital_secure_password"
DB_HOST="localhost"
DB_PORT="5432"

# CORS Origins (comma-separated)
CORS_ALLOWED_ORIGINS="http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174"
